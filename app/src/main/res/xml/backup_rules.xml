<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup rules for Android 11 (API 30) and below, referenced by
    android:fullBackupContent in the manifest.

    Everything is excluded, deliberately and permanently.

    PulseSSH stores an encrypted host database, wrapped SSH private keys and key material whose
    unwrapping key lives in the hardware-backed Android key store. That last part is the crux:
    hardware-backed keys are non-exportable and are bound to the device that generated them, so a
    backup could only ever contain ciphertext that no other device can open - a restore would look
    like silent, total data corruption to the user. Worse, the backup transport moves those files
    off the device, which turns a local-only threat model into a cloud one for no benefit at all.

    android:allowBackup is already false in the manifest, which makes this file redundant today.
    It is kept, and kept exhaustive, so that flipping allowBackup back on (by accident, or by a
    future feature that wants settings sync) cannot quietly start uploading secrets.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
